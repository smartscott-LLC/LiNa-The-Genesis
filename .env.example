# =========================
# CollabSmart Environment
# =========================
# Copy this file to .env and update values:
#   cp .env.example .env

# --- AI provider settings ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_PROVIDER=anthropic
AI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_BASE_URL=
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=4096
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=CollabSmart

# --- App URLs/ports ---
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_NOVNC_URL=http://localhost:6080
WORKSPACE_PATH=/workspace
LINA_SERVICE_URL=http://lina:8001

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=collabsmart
POSTGRES_USER=collabsmart
POSTGRES_PASSWORD=collabsmart

# --- Dragonfly/Redis ---
DRAGONFLY_HOST=dragonfly
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=collabsmart
DRAGONFLY_DB=0
DRAGONFLY_MAX_MEMORY=2gb

# --- LINA identity service ---
LINA_LOG_LEVEL=INFO
LINA_MODEL=claude-haiku-4-5-20251001
LINA_MAX_TOKENS=4096
# Computed automatically in docker-compose, optional override:
# DATABASE_URL=postgresql://<user>:<password>@postgres:5432/collabsmart
# REDIS_URL=redis://:collabsmart@dragonfly:6379

# --- Security ---
VNC_PASSWORD=collabsmart

# --- Optional O*NET integration ---
ONET_API_BASE=https://services.onetcenter.org/ws
ONET_USERNAME=
ONET_PASSWORD=

# --- Runtime settings ---
MEMORY_PROMOTION_THRESHOLD=5.0
WORKING_MEMORY_TTL_HOURS=48
SESSION_RECORDING_ENABLED=false
MAX_CONVERSATION_HISTORY=100
LOG_LEVEL=info
